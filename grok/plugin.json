{
  "id": "grok",
  "version": "0.1.1",
  "minCodeterm": "1.14.0",
  "hostApi": 2,
  "displayName": "Grok",
  "description": "xAI Grok CLI — optional PTY agent. Install the grok binary separately; not a core provider.",
  "readme": "README.md",
  "binaryName": "grok",
  "cliBinary": "grok",
  "entry": "plugin.js",
  "spawn": {
    "readinessStrategy": {
      "kind": "poll_shell_prompt",
      "timeoutSecs": 30
    },
    "taskDelivery": "inline_flag",
    "providerReadiness": {
      "kind": "structural_composer",
      "timeoutSecs": 180
    },
    "composerCursorPosition": "visible_anywhere",
    "systemPromptDelivery": {
      "kind": "external"
    },
    "verifySubmit": {
      "kind": "tui_input_drained"
    },
    "sessionIdInjection": "none",
    "statusBarRows": 1,
    "supportsLazySkills": false,
    "hasHooks": false,
    "sessionStartsOnFirstUserTurn": true
  },
  "models": [
    {
      "id": "grok-4.6",
      "displayName": "Grok 4.6",
      "description": "xAI frontier model.",
      "group": "xAI"
    },
    {
      "id": "grok-4.5",
      "displayName": "Grok 4.5",
      "description": "xAI previous frontier model.",
      "group": "xAI"
    }
  ],
  "defaultModel": "grok-4.6",
  "reasoningEfforts": [
    {
      "id": "low",
      "displayName": "Low",
      "description": "Quick, fast implementations."
    },
    {
      "id": "medium",
      "displayName": "Medium",
      "description": "Balanced effort with standard implementation and testing."
    },
    {
      "id": "high",
      "displayName": "High",
      "description": "Higher implementation quality with extensive reasoning."
    },
    {
      "id": "xhigh",
      "displayName": "Extra High",
      "description": "Highest effort and reasoning level."
    }
  ],
  "defaultReasoningEffort": "high",
  "sessions": {
    "rootDir": "~/.grok/sessions",
    "fileExtension": "jsonl"
  },
  "credentials": [
    {
      "id": "grokAuth",
      "file": "~/.grok/auth.json",
      "public": {
        "userId": "/https:~1~1auth.x.ai::b1a00492-073a-47ea-816f-4c329264a828/user_id"
      },
      "secret": {
        "accessToken": "/https:~1~1auth.x.ai::b1a00492-073a-47ea-816f-4c329264a828/key"
      }
    }
  ],
  "installer": {
    "macos": "curl -fsSL https://x.ai/cli/install.sh | bash",
    "linux": "curl -fsSL https://x.ai/cli/install.sh | bash",
    "windows": "irm https://x.ai/cli/install.ps1 | iex"
  },
  "updater": {
    "macos": "grok update",
    "linux": "grok update",
    "windows": "grok update"
  },
  "commands": {
    "stopKey": "\u0003",
    "usesWin32ControlKeys": true,
    "autoApproveFlags": [
      "--always-approve"
    ],
    "modelLaunchArgsFormat": [
      "--model",
      "{model}"
    ],
    "reasoningEffortLaunchArgsFormat": [
      "--reasoning-effort",
      "{effort}"
    ],
    "modelSwitch": "live_command",
    "modelSwitchCommands": {
      "readyInputRegex": "^\\s*│\\s*[>❯]\\s*│\\s*$",
      "turnCompletion": {
        "source": "session_file",
        "eventPointer": "/params/update/sessionUpdate",
        "eventValue": "turn_completed",
        "sessionPointer": "/params/sessionId",
        "startEventValue": "user_message_chunk",
        "turnPointer": "/params/update/prompt_id",
        "activeTurnPointer": "/params/_meta/promptId"
      },
      "confirmationSource": { "kind": "session_identity" },
      "model": { "command": "/model {model}" },
      "effort": { "command": "/effort {effort}" }
    }
  },
  "permissions": {
    "network": {
      "allow": [
        "x.ai",
        "cli-chat-proxy.grok.com",
        "auth.x.ai",
        "accounts.x.ai"
      ]
    },
    "subprocess": {
      "allow": [
        "grok",
        "agent"
      ]
    }
  },
  "icon": "icon.svg"
}
